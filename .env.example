# Copie para .env e ajuste os valores. O arquivo .env não é versionado (RNF07).

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Banco de dados
POSTGRES_DB=anuario
POSTGRES_USER=anuario
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Importação
DADOS_BRUTOS_DIR=/dados/brutos
DADOS_RELATORIOS_DIR=/dados/relatorios

# Frontend (o Vite repassa /api ao backend; não há CORS)
VITE_PROXY_API=http://backend:8000
VITE_REPOSITORIO_URL=https://github.com/yocaslu/projeto-integrador-ii

# Produção (infra/compose.prod.yml)
DOMINIO=exemplo.org
ACME_EMAIL=contato@exemplo.org
